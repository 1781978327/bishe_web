#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WEB_SPRINGBOOT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
LOCAL_GRADLE="$WEB_SPRINGBOOT_ROOT/gradle-8.14.1/bin/gradle"

if [ ! -x "$LOCAL_GRADLE" ]; then
    echo "未找到项目内预装 Gradle: $LOCAL_GRADLE" >&2
    exit 1
fi

exec "$LOCAL_GRADLE" "$@"
